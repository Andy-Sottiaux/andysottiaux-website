# Public read-only camera gateways
NEXT_PUBLIC_V3_CAMERA_GATEWAY_HOST=https://cam1.example.com
NEXT_PUBLIC_V3_CAMERA_2_GATEWAY_HOST=https://cam2.example.com

# Server-side relay paths and Thingino fallback credentials
V3_UPSTREAM_HOST=https://relay.example.ts.net
V3_HEALTH_UPSTREAM_HOST=https://relay.example.ts.net
V3_CAMERA_2_UPSTREAM_HOST=https://relay.example.ts.net/private-camera2-path
V3_CAMERA_2_USERNAME=replace-with-camera-user
V3_CAMERA_2_PASSWORD=replace-with-camera-password

# Physical-control authentication
# Generate CONTROL_AUTH_PASSWORD_HASH with:
# printf '%s' '<password>' | npm run control:hash
CONTROL_AUTH_PASSWORD_HASH=scrypt$16384$8$1$replace-with-salt$replace-with-digest
CONTROL_AUTH_SECRET=replace-with-at-least-32-random-characters
V3_DEVICE_CONTROL_RELAY_TOKEN=replace-with-the-relay-bearer-token

# Optional data sources
NEXT_PUBLIC_V3_SOLAR_URL=/api/v3/solar
