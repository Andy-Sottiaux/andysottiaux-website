    "hls.js": "^1.6.16",
    "lucide-react": "^1.24.0",
    "next": "^15.5.19",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.24",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "knip": "^6.18.0",
    "playwright": "^1.61.0",
    "postcss": "^8.5.15",
    "react-doctor": "^0.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
