{
  "name": "andysottiaux-website",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:a11y": "playwright test --grep @a11y",
    "audit:unused": "knip",
    "audit:deps": "depcruise --config .dependency-cruiser.cjs app components lib",
    "analyze": "ANALYZE=true next build",
    "check": "npm run typecheck && npm run build && npm --silent run doctor -- --score && npm run audit:unused && npm run audit:deps && npm run test:e2e",
    "score:production": "node scripts/audit-production-score.mjs",
    "test:camera": "node scripts/verify-camera-feed.mjs",
    "audit:camera-transport": "node scripts/audit-camera-transport.mjs",
    "audit:camera-transport:offtailnet": "bash scripts/audit-camera-transport-offtailnet.sh",
    "audit:home-performance": "node scripts/audit-home-performance.mjs",
    "monitor:production": "node scripts/monitor-production-health.mjs",
    "monitor:camera-playback": "node scripts/monitor-camera-playback.mjs",
    "monitor:page-stability": "node scripts/monitor-page-stability.mjs",
    "control:hash": "node scripts/hash-control-password.mjs",
    "doctor": "react-doctor"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
